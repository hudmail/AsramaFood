# Salin file ini menjadi .env lalu isi nilainya sebelum deploy

# Port aplikasi (opsional, default 3000)
PORT=3000

# Ganti dengan string acak panjang, contoh: openssl rand -hex 32
SESSION_SECRET=ganti-secret-ini-di-env

# Password default untuk akun owner & kasir saat pertama kali dijalankan
# (segera ganti setelah login pertama)
ADMIN_DEFAULT_PASSWORD=ganti-password-ini
